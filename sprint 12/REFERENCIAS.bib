@misc{alabsi2026empirical,
  title={An empirical evaluation of LLM-assisted sketch-based requirements elicitation and prototyping},
  author={Alabsi, Haya and Srinivasan, S. and Obeidat, R. and Lakew, N. and Andrew, M. and Zenebe, A.},
  year={2026},
  doi={10.21203/rs.3.rs-8475358/v1},
  note={Preprint, Research Square (30-ene-2026), CC BY 4.0 — ⚠️ SIN peer review. Los 6 autores son de Bowie State University (EE.UU.); varios agregadores dan afiliaciones erróneas. PDF: sprint 16/papers/. ⚠️ EVIDENCIA DÉBIL, verificado sobre el texto completo (4-ago-2026): **no hubo participantes** — el rol de stakeholder fue actuado ("a stakeholder role was simulated"), un solo sketch, 3 evaluadores todos técnicos, ICC(2,k)=0,518 (acuerdo moderado). Además es de **una sola pasada**: "LLMs generated requirements and prototypes in a single pass", sin iteración. Por lo tanto su afirmación de que "enables earlier validation" es **inferencial, no medida**. Citar solo como encuadre teórico (prototipo como boundary object) o como evidencia del hueco, nunca como evidencia de dinámicas con el negocio}
}

@inproceedings{mircea2026supporting,
  title={Supporting Stakeholder Requirements Expression with LLM Revisions: An Empirical Evaluation},
  author={Mircea, M. and Gevrek, E. and Schmid, E. and Schneider, K.},
  booktitle={Requirements Engineering: Foundation for Software Quality (REFSQ 2026)},
  series={Lecture Notes in Computer Science},
  pages={303--319},
  year={2026},
  publisher={Springer Nature Switzerland},
  doi={10.1007/978-3-032-21423-2_21},
  eprint={2601.16699v1},
  archivePrefix={arXiv},
  note={Ficha completada y verificada contra el texto completo (4-ago-2026). Leibniz Universität Hannover. PDF: sprint 16/papers/. Datos crudos y prompt: figshare.com/s/ba3cd02a6b69a49846f7. ⚠️ ALCANCE: 26 participantes = "software engineering students and professionals", todos usuarios activos de IDEs — **no hay actores de negocio**; el eje baja/alta experiencia es experiencia con IDEs, no negocio vs. técnico. Es **elicitación inicial** sobre un IDE hipotético: no hay software construido en ningún punto. Su "validación" es del enunciado del requisito, no de un entregable. Encuadre propio útil: "AI-in-the-Loop" (el humano conduce, la IA reformula), explícitamente opuesto a tratar al LLM como productor autónomo}
}

