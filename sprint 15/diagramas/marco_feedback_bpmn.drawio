        <!-- ================= FLUJOS DE MENSAJE (entre pools) ================= -->
        <mxCell id="m1" value="entrega del incremento" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#B85450;fontSize=9;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="A2a" target="A2b">
          <mxGeometry relative="1" as="geometry">
