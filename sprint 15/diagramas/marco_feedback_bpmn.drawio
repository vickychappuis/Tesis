            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="feedback del uso&lt;br&gt;(puede llegar antes de la ceremonia)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#B85450;fontSize=9;" edge="1" parent="1" source="A2b" target="A2c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="consulta / confirmación de la regla" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;startArrow=open;startFill=0;endArrow=open;endFill=0;strokeColor=#B85450;fontSize=9;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="A3a" target="A2b">
          <mxGeometry relative="1" as="geometry">
