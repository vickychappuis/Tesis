        </mxCell>
        <mxCell id="d6" edge="1" parent="1" source="A3b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=1 3;endArrow=openThin;endFill=0;strokeColor=#B38F00;" target="dFac">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d7" edge="1" parent="1" source="dFac" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=1 3;endArrow=openThin;endFill=0;strokeColor=#B38F00;" target="A4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d8" edge="1" parent="1" source="A4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=1 3;endArrow=openThin;endFill=0;strokeColor=#B38F00;" target="dsPB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d9" edge="1" parent="1" source="dsPB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=1 3;endArrow=openThin;endFill=0;strokeColor=#B38F00;" target="A5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#999999;fillColor=#FFFFFF;align=left;verticalAlign=top;fontSize=10;spacing=8;" value="&lt;b&gt;Leyenda (una sola semántica para todo el diagrama)&lt;/b&gt;&lt;br&gt;&lt;br&gt;▢ rectángulo redondeado azul = &lt;b&gt;actividad definida en Scrum&lt;/b&gt;&lt;br&gt;▢ rectángulo redondeado gris punteado = &lt;b&gt;actividad de la práctica, ⚠ no definida en Scrum&lt;/b&gt;&lt;br&gt;▢ nota amarilla = &lt;b&gt;objeto de datos&lt;/b&gt; (artefacto que se produce o consume)&lt;br&gt;▢ cilindro violeta = &lt;b&gt;almacén de datos&lt;/b&gt; (Product Backlog, persiste entre Sprints)&lt;br&gt;▢ carril = &lt;b&gt;rol&lt;/b&gt; · pool = participante&lt;br&gt;→ flecha llena negra = &lt;b&gt;flujo de secuencia&lt;/b&gt; (orden de las actividades, dentro del mismo participante)&lt;br&gt;⇢ flecha punteada roja = &lt;b&gt;flujo de mensaje&lt;/b&gt; (comunicación entre participantes)&lt;br&gt;⇢ flecha punteada fina amarilla = &lt;b&gt;asociación de datos&lt;/b&gt; (lectura o escritura de un artefacto)&lt;br&gt;↻ = actividad continua, no un evento&lt;br&gt;&lt;br&gt;&lt;i&gt;Notación: BPMN (subconjunto). Anclaje: Dumas et al. (2018). Vocabulario de actividades y artefactos: Scrum Guide 2020.&lt;/i&gt;" vertex="1">
          <mxGeometry height="220" width="700" x="40" y="850" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#6C8EBF;fillColor=#F0F5FF;align=left;verticalAlign=top;fontSize=10;spacing=8;" value="&lt;b&gt;Por qué el zoom no es solo la ceremonia&lt;/b&gt;&lt;br&gt;&lt;br&gt;La Scrum Guide 2020 desacopla explícitamente la liberación de la Sprint Review:&lt;br&gt;&lt;i&gt;“an Increment may be delivered to stakeholders prior to the end of the Sprint. The Sprint Review should never be considered a gate to releasing value.”&lt;/i&gt;&lt;br&gt;&lt;br&gt;De ahí que A2a (liberación) y A2b (uso y testing de aceptación) estén fuera de la ceremonia y por fuera de lo que Scrum define: el framework es &lt;i&gt;“purposefully incomplete”&lt;/i&gt; y funciona como &lt;i&gt;“container for other techniques”&lt;/i&gt;.&lt;br&gt;&lt;br&gt;Consecuencia para el objetivo B: el feedback del negocio tiene &lt;b&gt;más de un canal y más de un momento&lt;/b&gt; — no solo la review." vertex="1">
          <mxGeometry height="220" width="620" x="770" y="850" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
